---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allEntries = await getCollection('days');
const entries = allEntries
  .map((entry) => {
    const body = entry.body || '';
    const titleMatch = body.match(/^# Wonderland\s*[—–-]\s*([^\n(]+?)(?:\s*\(run\s+(\d+)\))?\s*$/m);

    // Find every spark image, paired with its title (alt text or preceding heading).
    // Each ![#N — Title](url) is a featured spark. We capture groups (n, title, url).
    const imageRegex = /!\[#(\d+)\s*[—–-]\s*([^\]]+)\]\(([^)]+)\)/g;
    const featuredSparks = [];
    let m;
    while ((m = imageRegex.exec(body)) !== null) {
      featuredSparks.push({ n: m[1], title: m[2].trim(), url: m[3] });
    }

    // Fallback: also accept any image after `## 配图` even if alt text differs.
    if (featuredSparks.length === 0) {
      const gallery = body.match(/## 配图[^]*?(?=^## |\Z)/m)?.[0] || '';
      const genericImgRe = /!\[[^\]]*\]\((https?:\/\/[^)]+)\)/g;
      let g;
      while ((g = genericImgRe.exec(gallery)) !== null) {
        featuredSparks.push({ n: '·', title: 'Spark image', url: g[1] });
      }
    }

    const cards = [...body.matchAll(/^###\s+💥\s+#(\d+)\s+[—–-]\s+(.+)$/gm)].map((mm) => ({
      n: mm[1],
      title: mm[2].trim(),
    }));
    const collisions = [...body.matchAll(/^##\s+组合\s+\d+[：:]\s*(.+?)\s*$/gm)].map((mm) => mm[1].trim());

    return {
      slug: entry.id,
      dateLabel: titleMatch?.[1].trim() || entry.id,
      runHint: titleMatch?.[2] || body.match(/\(run\s+(\d+)\)/)?.[1] || null,
      collisions,
      cardCount: cards.length,
      cards,
      featuredSparks,
      topCards: cards.slice(0, 3),
    };
  })
  .sort((a, b) => {
    const dateA = a.slug.match(/(\d{4}-\d{2}-\d{2})/)?.[1] || '';
    const dateB = b.slug.match(/(\d{4}-\d{2}-\d{2})/)?.[1] || '';
    if (dateA !== dateB) return dateB.localeCompare(dateA);
    return Number(b.runHint || 1) - Number(a.runHint || 1);
  });

const totalCards = entries.reduce((acc, e) => acc + e.cardCount, 0);
const totalFeatured = entries.reduce((acc, e) => acc + e.featuredSparks.length, 0);
const latest = entries[0];
const dateOfLatest = latest?.slug.match(/(\d{4}-\d{2}-\d{2})/)?.[1] || '—';
---

<BaseLayout title={`Wonderland — ${entries.length} nights, ${totalCards} sparks`}>
  <section class="hero container">
    <p class="kicker">Nightly idea collisions · auto-published every morning</p>
    <h1 class="title">A machine that crosses wires between domains, then asks <em>what if</em>.</h1>
    <p class="lede">
      Every night, Wonderland pairs two fields it has never met, adds a constraint no one asked for,
      and writes down the sparks. The full night — search trails, anchors, and side-quest notes —
      publishes here each morning at 04:30 CST.
    </p>
    {latest && (
      <div class="latest-cta">
        <a href={`/days/${latest.slug}/`} class="btn-primary">Read {dateOfLatest} →</a>
        <span class="latest-meta">{latest.cardCount} sparks · {latest.featuredSparks.length} featured · {latest.collisions.length} collisions</span>
      </div>
    )}
  </section>

  <section class="log container">
    <header class="log-header">
      <h2>The Log</h2>
      <p class="count">{entries.length} night{entries.length === 1 ? '' : 's'} · {totalCards} sparks · {totalFeatured} featured</p>
    </header>

    {entries.length === 0 ? (
      <p class="empty">No nights yet. Run the sync script to publish the first archive.</p>
    ) : (
      <ol class="entry-list" reversed>
        {entries.map((entry) => (
          <li class="entry">
            <header class="entry-head">
              <h3 class="entry-date">
                {entry.dateLabel}
                {entry.runHint && <span class="run-badge">run {entry.runHint}</span>}
              </h3>
              <p class="entry-meta">
                <span>{entry.cardCount} sparks</span>
                {entry.featuredSparks.length > 0 && (
                  <>
                    <span class="dot">·</span>
                    <span>{entry.featuredSparks.length} featured</span>
                  </>
                )}
                <span class="dot">·</span>
                <span>{entry.collisions.length} collisions</span>
              </p>
            </header>

            {entry.collisions.length > 0 && (
              <p class="entry-collisions">
                {entry.collisions.map((c) => (
                  <span class="collision-chip">{c}</span>
                ))}
              </p>
            )}

            {entry.featuredSparks.length > 0 && (
              <div class="featured-strip">
                {entry.featuredSparks.map((spark) => (
                  <a href={`/days/${entry.slug}/`} class="featured-spark">
                    <div class="featured-image">
                      <img src={spark.url} alt={`#${spark.n} — ${spark.title}`} loading="lazy" />
                      <span class="featured-badge">#{spark.n}</span>
                    </div>
                    <p class="featured-title">#{spark.n} — {spark.title}</p>
                  </a>
                ))}
              </div>
            )}

            {entry.topCards.length > 0 && (
              <ul class="entry-top">
                {entry.topCards.map((c) => (
                  <li><strong>#{c.n}</strong> {c.title}</li>
                ))}
              </ul>
            )}

            <a href={`/days/${entry.slug}/`} class="entry-readmore">
              Read the full night →
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 4rem 1.5rem 3rem;
    border-bottom: 1px solid var(--border);
  }

  .kicker {
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--text);
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  .title em { font-style: italic; color: var(--accent); }

  .lede {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    color: var(--text-muted);
    max-width: 56ch;
    line-height: 1.7;
  }

  .latest-cta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.25rem;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.9375rem;
    transition: background 0.2s, transform 0.15s;
  }
  .btn-primary:hover {
    background: var(--accent-hover);
    color: #fff;
    transform: translateY(-1px);
  }

  .latest-meta {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .log {
    padding: 3rem 1.5rem 4rem;
  }

  .log-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .log-header h2 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .count {
    color: var(--text-dim);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .empty {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-dim);
    font-style: italic;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }

  .entry-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .entry {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.75rem;
    transition: border-color 0.15s, box-shadow 0.2s;
  }
  .entry:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  .entry-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .entry-date {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .run-badge {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-dim);
    background: var(--bg-alt);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .entry-meta {
    color: var(--text-dim);
    font-size: 0.8125rem;
    display: flex;
    gap: 0.4rem;
  }

  .entry-collisions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .collision-chip {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    background: var(--accent-subtle);
    color: var(--accent);
    border-radius: 999px;
    font-weight: 500;
  }

  /* Featured sparks strip (带图 spark — main visual hook) */
  .featured-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin: 1.25rem 0 1.25rem;
  }

  .featured-spark {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    color: inherit;
  }
  .featured-spark:hover { color: inherit; }

  .featured-image {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-alt);
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.2, 0, 0.2, 1);
  }

  .featured-spark:hover .featured-image img {
    transform: scale(1.04);
  }

  .featured-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: rgba(0, 0, 0, 0.78);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }

  .featured-title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .entry-top {
    list-style: none;
    padding: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-top: 1px dashed var(--border);
    margin-top: 0.5rem;
  }

  .entry-top li {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .entry-top li strong {
    color: var(--accent);
    font-weight: 600;
    margin-right: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .entry-readmore {
    display: inline-flex;
    align-items: center;
    margin-top: 1.1rem;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.875rem;
  }
  .entry-readmore:hover { color: var(--accent-hover); }

  @media (max-width: 640px) {
    .featured-strip { grid-template-columns: 1fr; }
    .entry { padding: 1.25rem 1.25rem; }
  }
</style>