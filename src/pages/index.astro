---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const MAX_FEATURED_PER_NIGHT = 8;

const MONTH_NAMES = ['一月','二月','三月','四月','五月','六月','七月','八月','九月','十月','十一月','十二月'];

const allEntries = await getCollection('days');
const entries = allEntries
  .map((entry) => {
    const body = entry.body || '';
    const titleMatch = body.match(/^# Wonderland\s*[—–-]\s*([^\n(]+?)(?:\s*\(run\s+(\d+)\))?\s*$/m);

    // Featured sparks: walk every spark card and pull the image URL that lives
    // right after its `**画面**` line. The image lives next to the spark it
    // belongs to, not in a separate gallery section.
    const sparkBlockRe = /^###\s+💥\s+#(\d+)\s+[—–-]\s+([^\n]+)\n([\s\S]*?)(?=^###\s|^##\s|\Z)/gm;
    const featuredSparks = [];
    let sp;
    while ((sp = sparkBlockRe.exec(body)) !== null) {
      const n = sp[1];
      const title = sp[2].trim();
      const block = sp[3];
      const imgMatch = block.match(/!\[\s*#\d+\s*[—–-]\s*([^\]]+)\]\(([^)]+)\)/);
      if (imgMatch) {
        featuredSparks.push({ n, title: title.replace(/\s*[:：].*$/, ''), url: imgMatch[2] });
      }
    }

    const cards = [...body.matchAll(/^###\s+💥\s+#(\d+)\s+[—–-]\s+(.+)$/gm)].map((mm) => ({
      n: mm[1],
      title: mm[2].trim(),
    }));
    // 组合标题存在数字（组合 1：）与字母（组合 A：）两种形态。
    let collisions = [...body.matchAll(/^##\s+组合\s+[0-9A-Z]+[：:]\s*(.+?)\s*$/gm)].map((mm) => mm[1].trim());
    if (collisions.length === 0) {
      // 无组合标题的期数：从每张卡片的 **碰撞**: 字段提取去重列表。
      const seen = new Set();
      for (const mm of body.matchAll(/^\*\*碰撞\*\*[:：]\s*(.+?)\s*$/gm)) {
        const c = mm[1].trim();
        if (!seen.has(c)) {
          seen.add(c);
          collisions.push(c);
        }
        if (collisions.length >= 3) break;
      }
    }

    return {
      slug: entry.id,
      dateLabel: titleMatch?.[1].trim() || entry.id,
      date: entry.id.match(/(\d{4})-(\d{2})-(\d{2})/)?.slice(1) || null,
      runHint: titleMatch?.[2] || body.match(/\(run\s+(\d+)\)/)?.[1] || null,
      collisions,
      cardCount: cards.length,
      cards,
      featuredSparks: featuredSparks.slice(0, MAX_FEATURED_PER_NIGHT),
      hasMoreFeatured: featuredSparks.length > MAX_FEATURED_PER_NIGHT,
      topCards: cards.slice(0, 3),
    };
  })
  .sort((a, b) => {
    const dateA = a.slug.match(/(\d{4}-\d{2}-\d{2})/)?.[1] || '';
    const dateB = b.slug.match(/(\d{4}-\d{2}-\d{2})/)?.[1] || '';
    if (dateA !== dateB) return dateB.localeCompare(dateA);
    return Number(b.runHint || 1) - Number(a.runHint || 1);
  });

const totalCards = entries.reduce((acc, e) => acc + e.cardCount, 0);
const latest = entries[0];
const pastEntries = entries.slice(1);

// Group the archive by month (desc),月刊式时间线。
const months = [];
for (const e of pastEntries) {
  const key = e.date ? `${e.date[0]}-${e.date[1]}` : '未知';
  let m = months.find((mm) => mm.key === key);
  if (!m) {
    m = {
      key,
      label: e.date ? `${e.date[0]} 年 ${MONTH_NAMES[Number(e.date[1]) - 1]}` : key,
      items: [],
    };
    months.push(m);
  }
  m.items.push(e);
}

const latestFeatured = latest ? latest.topCards.map((c) => {
  const img = latest.featuredSparks.find((f) => f.n === c.n);
  return { ...c, url: img?.url || null };
}) : [];
---

<BaseLayout title="Wonderland — 跨域灵感日志" description="每天把两个陌生的领域碰撞一次，记下产生的火花。">
  <section class="hero container">
    <p class="kicker" data-reveal>✺ 跨域灵感日志 · CROSS-DOMAIN SPARK LOG</p>
    <h1 class="title" data-reveal style="--rd:80ms">
      <span class="title-word grad-text">Wonderland</span>
      <span class="title-sub">把两个陌生的领域撞在一起，<br />看会冒出什么<em>火花</em>。</span>
    </h1>
    <p class="lede" data-reveal style="--rd:160ms">
      一个跨领域灵感的常态化实验：每日遴选两个看似无关的领域，
      引入一项约束命题，检索相关文献锚点，记录所产生的火花。
      此处不展示创作过程，只呈现最终的火花与参考文献。
    </p>
    {latest && (
      <div class="latest-cta" data-reveal style="--rd:240ms">
        <a href={`/days/${latest.slug}/`} class="btn-primary magnetic">阅读本期 →</a>
        <span class="latest-meta">{entries.length} 期 · {totalCards} 张卡片</span>
      </div>
    )}
  </section>

  {latest && (
    <section class="tonight container" data-reveal>
      <header class="section-head">
        <p class="section-kicker">最新一期</p>
        <h2 class="section-title">
          <a href={`/days/${latest.slug}/`}>{latest.dateLabel}</a>
        </h2>
        <p class="section-meta">{latest.cardCount} 张卡片 · {latest.collisions.length} 组碰撞</p>
      </header>

      <div class="tonight-grid">
        {latestFeatured.map((c, i) => (
          <a href={`/days/${latest.slug}/`} class="tonight-card" data-reveal style={`--rd:${i * 90}ms`}>
            {c.url && (
              <div class="tonight-image">
                <img src={c.url} alt={`#${c.n} — ${c.title}`} loading="lazy" />
              </div>
            )}
            <div class="tonight-body">
              <span class="tonight-num">№ {String(c.n).padStart(2, '0')}</span>
              <p class="tonight-title">{c.title}</p>
            </div>
          </a>
        ))}
      </div>

      {latest.collisions.length > 0 && (
        <p class="tonight-collisions">
          {latest.collisions.map((c) => (
            <span class="chip">{c}</span>
          ))}
        </p>
      )}
    </section>
  )}

  <section class="log container">
    <header class="section-head log-header" data-reveal>
      <p class="section-kicker">归档</p>
      <h2 class="section-title">往期日志</h2>
      <p class="section-meta">共 {entries.length} 期 · {totalCards} 张卡片</p>
    </header>

    {entries.length === 0 ? (
      <p class="empty">还没有内容。先跑一次同步脚本把 archive 发布上来。</p>
    ) : (
      <div class="timeline">
        {months.map((m) => (
          <section class="month" data-reveal>
            <h3 class="month-label">
              <span class="month-cn">{m.label}</span>
              <span class="month-key">{m.key}</span>
            </h3>
            <ol class="month-list" reversed>
              {m.items.map((entry) => (
                <li class="entry">
                  <a href={`/days/${entry.slug}/`} class="entry-link">
                    <span class="entry-day">{entry.date ? entry.date[2] : '—'}</span>
                    <span class="entry-main">
                      <span class="entry-title">{entry.topCards[0] ? entry.topCards[0].title : entry.dateLabel}</span>
                      <span class="entry-meta">
                        {entry.cardCount} 张火花 · {entry.collisions.length} 组碰撞
                        {entry.collisions.length > 0 && (
                          <span class="entry-collision">{entry.collisions[0]}</span>
                        )}
                      </span>
                    </span>
                    {entry.featuredSparks.length > 0 && (
                      <span class="entry-thumbs">
                        {entry.featuredSparks.slice(0, 3).map((spark) => (
                          <img src={spark.url} alt={`#${spark.n} — ${spark.title}`} loading="lazy" />
                        ))}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<script>
  // Magnetic CTA: the primary button leans toward the cursor.
  document.querySelectorAll('.magnetic').forEach((el) => {
    const strength = 18;
    el.addEventListener('mousemove', (e) => {
      const r = el.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width / 2);
      const dy = e.clientY - (r.top + r.height / 2);
      el.style.transform = `translate(${(dx / r.width) * strength}px, ${(dy / r.height) * strength}px)`;
    });
    el.addEventListener('mouseleave', () => {
      el.style.transform = '';
    });
  });
</script>

<style>
  /* ---- hero ---- */
  .hero {
    padding: 6.5rem 1.5rem 4.5rem;
  }

  .kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 1.75rem;
  }

  .title {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .title-word {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(3.5rem, 9vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .title-sub {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    font-weight: 900;
    line-height: 1.35;
    color: var(--text);
    letter-spacing: 0.01em;
    max-width: 26ch;
  }

  .title-sub em {
    font-style: normal;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .lede {
    margin-top: 1.75rem;
    font-size: 1.0625rem;
    color: var(--text-muted);
    max-width: 56ch;
    line-height: 1.85;
  }

  .latest-cta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.75rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.8rem 1.6rem;
    background: var(--grad);
    color: #fff;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    box-shadow: var(--shadow-md), var(--glow);
    transition: transform 0.25s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.25s, filter 0.25s;
    will-change: transform;
  }
  .btn-primary:hover {
    color: #fff;
    filter: brightness(1.12);
    box-shadow: var(--shadow-lg), var(--glow);
  }

  .latest-meta {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  /* ---- section heads ---- */
  .section-head { margin-bottom: 2.5rem; }

  .section-kicker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 900;
    letter-spacing: 0.01em;
    line-height: 1.2;
    color: var(--text);
  }
  .section-title a { color: inherit; }
  .section-title a:hover { color: var(--accent); }

  .section-meta {
    margin-top: 0.5rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  /* ---- tonight (latest issue) ---- */
  .tonight {
    padding: 1rem 1.5rem 5rem;
  }

  .tonight-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .tonight-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: inherit;
    box-shadow: var(--shadow);
    transition: transform 0.3s cubic-bezier(0.2, 0, 0.2, 1), border-color 0.3s, box-shadow 0.3s;
  }
  .tonight-card:hover {
    color: inherit;
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-lg), var(--glow);
  }

  .tonight-image {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--bg-alt);
  }

  .tonight-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.2, 0, 0.2, 1);
  }
  .tonight-card:hover .tonight-image img { transform: scale(1.05); }

  .tonight-body {
    padding: 1.1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tonight-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .tonight-title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tonight-collisions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }

  /* ---- archive timeline ---- */
  .log {
    padding: 0 1.5rem 4rem;
  }

  .empty {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-dim);
    font-style: italic;
    font-family: var(--font-serif);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .month-label {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .month-cn {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    color: var(--text);
  }

  .month-key {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-dim);
    letter-spacing: 0.1em;
  }

  .month-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .entry-link {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.45rem 1rem;
    margin: 0 -1rem;
    border-radius: var(--radius);
    color: inherit;
    border: 1px solid transparent;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .entry-link:hover {
    color: inherit;
    background: var(--bg-card);
    border-color: var(--border);
    transform: translateX(4px);
    box-shadow: var(--shadow);
  }

  .entry-day {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text-dim);
    min-width: 2.6rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
    transition: color 0.2s;
  }
  .entry-link:hover .entry-day {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .entry-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .entry-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .entry-meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.06em;
  }

  .entry-collision {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: 0.02em;
    opacity: 0.85;
  }
  .entry-collision::before { content: '· '; }

  .entry-thumbs {
    flex: 0 0 auto;
    display: flex;
    gap: 0.4rem;
  }

  .entry-thumbs img {
    width: 52px;
    height: 36px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--border);
    display: block;
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  .entry-link:hover .entry-thumbs img { opacity: 1; }

  @media (max-width: 760px) {
    .hero { padding: 4rem 1.5rem 3rem; }
    .tonight-grid { grid-template-columns: 1fr; }
    .entry-link { gap: 1rem; padding: 1.25rem 1rem; }
    .entry-day { font-size: 1.5rem; min-width: 2rem; }
    .entry-thumbs { display: none; }
    .entry-title { white-space: normal; }
    .entry-collision { display: none; }
  }
</style>
