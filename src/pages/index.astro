---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const allEntries = await getCollection('days');
const entries = allEntries
  .map((entry) => {
    const body = entry.body || '';
    const titleMatch = body.match(/^# Wonderland\s*[—–-]\s*([^\n(]+?)(?:\s*\(run\s+\d+\))?\s*$/m);
    const summaryMatch = body.match(/## 速览[^]*?\n([\s\S]*?)(?=\n## |\n$)/);
    const cards = [...body.matchAll(/^###\s+💥\s+#(\d+)\s+[—–-]\s+(.+)$/gm)].map((m) => ({
      n: m[1],
      title: m[2].trim(),
    }));
    const collisions = [...body.matchAll(/^##\s+组合\s+\d+[：:]\s*(.+?)(?:\s*=\s*约束.*|\s*\+.*)?$/gm)].map((m) => m[1].trim());
    return {
      slug: entry.id,
      dateLabel: titleMatch?.[1].trim() || entry.id,
      runHint: body.match(/\(run\s+(\d+)\)/)?.[1] || null,
      collisions,
      summary: summaryMatch?.[1]?.trim().split('\n').slice(0, 8).join('\n').trim() || '',
      cards,
      cardCount: cards.length,
      topCards: cards.slice(0, 3),
    };
  })
  .sort((a, b) => {
    const dateA = a.slug.match(/(\d{4}-\d{2}-\d{2})/)?.[1] || '';
    const dateB = b.slug.match(/(\d{4}-\d{2}-\d{2})/)?.[1] || '';
    if (dateA !== dateB) return dateB.localeCompare(dateA);
    return Number(b.runHint || 1) - Number(a.runHint || 1);
  });

const totalCards = entries.reduce((acc, e) => acc + e.cardCount, 0);
const latest = entries[0];
const dateOfLatest = latest?.slug.match(/(\d{4}-\d{2}-\d{2})/)?.[1] || '—';
---

<BaseLayout title={`Wonderland — ${entries.length} nights, ${totalCards} sparks`}>
  <section class="hero container">
    <p class="kicker">Nightly idea collisions · auto-published every morning</p>
    <h1 class="title">A machine that crosses wires between domains, then asks <em>what if</em>.</h1>
    <p class="lede">
      Every night, Wonderland pairs two fields it has never met, adds a constraint no one asked for,
      and writes down the sparks. The full night — search trails, anchors, and side-quest notes —
      publishes here each morning at 04:30 CST.
    </p>
    {latest && (
      <div class="latest-cta">
        <a href={`/days/${latest.slug}/`} class="btn-primary">Read {dateOfLatest} →</a>
        <span class="latest-meta">{latest.cardCount} sparks · {latest.collisions.length} collisions</span>
      </div>
    )}
  </section>

  <section class="log container">
    <header class="log-header">
      <h2>The Log</h2>
      <p class="count">{entries.length} night{entries.length === 1 ? '' : 's'} · {totalCards} sparks</p>
    </header>

    {entries.length === 0 ? (
      <p class="empty">No nights yet. Run the sync script to publish the first archive.</p>
    ) : (
      <ol class="entry-list" reversed>
        {entries.map((entry) => (
          <li class="entry">
            <a href={`/days/${entry.slug}/`} class="entry-link">
              <header class="entry-head">
                <h3 class="entry-date">
                  {entry.dateLabel}
                  {entry.runHint && <span class="run-badge">run {entry.runHint}</span>}
                </h3>
                <p class="entry-meta">
                  <span>{entry.cardCount} sparks</span>
                  <span class="dot">·</span>
                  <span>{entry.collisions.length} collisions</span>
                </p>
              </header>
              {entry.collisions.length > 0 && (
                <p class="entry-collisions">
                  {entry.collisions.map((c) => (
                    <span class="collision-chip">{c}</span>
                  ))}
                </p>
              )}
              {entry.summary && <p class="entry-summary">{entry.summary.replace(/^[-*]\s*/, '').split('\n').slice(0, 4).join(' · ')}</p>}
              {entry.topCards.length > 0 && (
                <ul class="entry-top">
                  {entry.topCards.map((c) => (
                    <li><strong>#{c.n}</strong> {c.title}</li>
                  ))}
                </ul>
              )}
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 4rem 1.5rem 3rem;
    border-bottom: 1px solid var(--border);
  }

  .kicker {
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--text);
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  .title em {
    font-style: italic;
    color: var(--accent);
  }

  .lede {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    color: var(--text-muted);
    max-width: 56ch;
    line-height: 1.7;
  }

  .latest-cta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.25rem;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.9375rem;
    transition: background 0.2s, transform 0.15s;
  }
  .btn-primary:hover {
    background: var(--accent-hover);
    color: #fff;
    transform: translateY(-1px);
  }

  .latest-meta {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .log {
    padding: 3rem 1.5rem 4rem;
  }

  .log-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .log-header h2 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .count {
    color: var(--text-dim);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .empty {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-dim);
    font-style: italic;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
  }

  .entry-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .entry {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color 0.15s, box-shadow 0.2s, transform 0.15s;
  }
  .entry:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  .entry-link {
    display: block;
    padding: 1.5rem 1.75rem;
    color: inherit;
  }
  .entry-link:hover {
    color: inherit;
  }

  .entry-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .entry-date {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .run-badge {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-dim);
    background: var(--bg-alt);
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .entry-meta {
    color: var(--text-dim);
    font-size: 0.8125rem;
    display: flex;
    gap: 0.4rem;
  }

  .entry-collisions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .collision-chip {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    background: var(--accent-subtle);
    color: var(--accent);
    border-radius: 999px;
    font-weight: 500;
  }

  .entry-summary {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.85rem;
    line-height: 1.55;
  }

  .entry-top {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--border);
  }

  .entry-top li {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .entry-top li strong {
    color: var(--accent);
    font-weight: 600;
    margin-right: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
</style>
