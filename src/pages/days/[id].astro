---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('days');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const body = entry.body || '';
const titleMatch = body.match(/^# Wonderland\s*[—–-]\s*([^\n(]+?)(?:\s*\(run\s+(\d+)\))?\s*$/m);
const collisionToc = [...body.matchAll(/^##\s+组合\s+\d+[：:]\s*(.+?)\s*$/gm)].map((m) => m[1].trim());

const dateLabel = titleMatch?.[1]?.trim() || entry.id;
const runHint = titleMatch?.[2] || null;

const allEntries = await getCollection('days');
const sorted = allEntries
  .map((e) => ({
    id: e.id,
    dateLabel: (e.body || '').match(/^# Wonderland\s*[—–-]\s*([^\n(]+?)(?:\s*\(run\s+\d+\))?\s*$/m)?.[1]?.trim() || e.id,
    runHint: (e.body || '').match(/\(run\s+(\d+)\)/)?.[1] || null,
  }))
  .sort((a, b) => {
    const da = a.id.match(/(\d{4}-\d{2}-\d{2})/)?.[1] || '';
    const db = b.id.match(/(\d{4}-\d{2}-\d{2})/)?.[1] || '';
    if (da !== db) return db.localeCompare(da);
    return Number(b.runHint || 1) - Number(a.runHint || 1);
  });
const idx = sorted.findIndex((e) => e.id === entry.id);
const newer = sorted[idx + 1];
const older = sorted[idx - 1];
---

<BaseLayout title={`${dateLabel} — Wonderland`}>
  <article class="day container">
    <nav class="back-link">
      <a href="/">← 日志</a>
    </nav>

    <header class="day-head">
      <p class="day-meta">{dateLabel}</p>
      <h1 class="day-title">
        {dateLabel}
      </h1>
      {collisionToc.length > 0 && (
        <ul class="day-toc">
          {collisionToc.map((c) => (
            <li><span class="toc-bullet">↳</span> {c}</li>
          ))}
        </ul>
      )}
    </header>

    <div class="day-body">
      <Content components={{}} />
    </div>

    <nav class="day-nav">
      {older ? (
        <a href={`/days/${older.id}/`} class="day-nav-link prev">
          <span class="nav-arrow">←</span>
          <span class="nav-meta">
            <span class="nav-kicker">更早一期</span>
            <span class="nav-title">{older.dateLabel}</span>
          </span>
        </a>
      ) : <span class="day-nav-spacer" />}
      {newer ? (
        <a href={`/days/${newer.id}/`} class="day-nav-link next">
          <span class="nav-meta">
            <span class="nav-kicker">更新一期</span>
            <span class="nav-title">{newer.dateLabel}</span>
          </span>
          <span class="nav-arrow">→</span>
        </a>
      ) : <span class="day-nav-spacer" />}
    </nav>
  </article>
</BaseLayout>

<style is:global>
  .day-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text);
  }

  .day-body > h1, .day-body > h2, .day-body > h3 {
    font-family: var(--font-serif);
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .day-body > h1 { display: none; }

  .day-body > h2 {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 3rem 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }

  .day-body > h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
    color: var(--accent);
  }

  .day-body p { margin: 0.8rem 0; }

  .day-body ul, .day-body ol { margin: 0.8rem 0 0.8rem 1.5rem; }
  .day-body li { margin: 0.3rem 0; }

  .day-body blockquote {
    border-left: 3px solid var(--accent);
    margin: 1rem 0;
    padding: 0.4rem 0 0.4rem 1rem;
    color: var(--text-muted);
    font-style: italic;
    font-family: var(--font-serif);
    background: var(--accent-subtle);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .day-body img {
    display: block;
    width: 100%;
    max-width: 720px;
    margin: 1.5rem auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .day-body hr {
    border: none;
    border-top: 1px dashed var(--border);
    margin: 2.5rem 0;
  }

  /* Spark card (h3 💥 #N — ... + adjacent dl.spark-meta) */
  .day-body section.spark-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    margin: 2rem 0;
    overflow: hidden;
    transition: border-color 0.15s, transform 0.15s;
  }
  .day-body section.spark-card:hover {
    border-color: var(--accent);
  }

  .day-body section.spark-card > h3 {
    margin: 0;
    padding: 1rem 1.25rem;
    background: var(--bg-alt);
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    border-bottom: 1px solid var(--border);
  }

  .day-body dl.spark-meta {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.65rem 1.25rem;
    margin: 0;
    padding: 1rem 1.25rem 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .day-body .spark-meta dt {
    color: var(--text-dim);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-top: 0.25rem;
    align-self: start;
  }

  .day-body .spark-meta dd {
    margin: 0;
    color: var(--text);
  }

  .day-body .spark-meta dt.dt-score {
    color: var(--accent);
  }

  .day-body .spark-meta dd.dd-score {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .day-body .spark-meta .score-num {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    min-width: 1.5rem;
  }

  .day-body .spark-meta .score-bar {
    display: inline-block;
    width: 110px;
    height: 6px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
    flex: 0 0 110px;
  }

  .day-body .spark-meta .score-bar-fill {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
    transition: width 0.4s cubic-bezier(0.2, 0, 0.2, 1);
  }

  /* 画面 row gets a hint of color so the visual description stands out */
  .day-body .spark-meta dt:has-text {
    /* no-op; placeholder for browser consistency */
  }

  /* Gallery (## 配图) */
  .day-body .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .day-body .gallery figure {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-alt);
  }

  .day-body .gallery img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    margin: 0;
    border: none;
    border-radius: 0;
  }

  .day-body .gallery figcaption {
    padding: 0.6rem 0.85rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-serif);
  }

  /* Image embedded inside the spark card (e.g. "画面" row carrying ![]()) */
  .day-body .spark-meta .dd-image {
    display: block;
    width: 100%;
    max-width: 720px;
    margin: 0.75rem 0 0.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-alt);
  }

  /* Image sitting as its own paragraph immediately after a spark card */
  .day-body section.spark-card + p:has(> img) {
    margin: 0 0 2rem;
    text-align: center;
  }
  .day-body section.spark-card + p > img {
    display: block;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-alt);
  }

  /* Quote inside a spark card (连接点分析 blockquote) gets softer styling */
  .day-body section.spark-card blockquote {
    margin: 0.6rem 1.25rem 0.6rem;
    background: var(--bg-alt);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  /* First paragraph of a spark card (often 连接点) reads as the lede */
  .day-body section.spark-card > p:first-of-type {
    margin: 0.85rem 1.25rem 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .day-body dl.spark-meta { grid-template-columns: 1fr; gap: 0.25rem 0; }
    .day-body .spark-meta dt { padding-top: 0.5rem; }
    .day-body .spark-meta dt:first-child { padding-top: 0; }
  }
</style>

<style>
  .day {
    padding: 2rem 1.5rem 4rem;
  }

  .back-link {
    margin-bottom: 2rem;
  }
  .back-link a {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .back-link a:hover { color: var(--accent); }

  .day-head {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--border);
  }

  .day-meta {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .day-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1.1;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .day-run {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-dim);
    background: var(--bg-alt);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .day-toc {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 1rem 1.25rem;
    background: var(--bg-alt);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .day-toc li {
    font-size: 0.9rem;
    color: var(--text-muted);
    display: flex;
    gap: 0.6rem;
  }
  .toc-bullet { color: var(--accent); }

  .day-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .day-nav-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    transition: border-color 0.15s, color 0.15s, transform 0.15s;
    min-height: 64px;
  }
  .day-nav-link.prev { text-align: left; }
  .day-nav-link.next { text-align: right; justify-self: end; }
  .day-nav-link:hover {
    border-color: var(--accent);
    color: var(--text);
    transform: translateY(-1px);
  }

  .nav-arrow {
    font-size: 1.25rem;
    color: var(--accent);
    line-height: 1;
  }

  .nav-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .day-nav-link.next .nav-meta { align-items: flex-end; }

  .nav-kicker {
    font-size: 0.7rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .nav-title {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .day-nav-spacer { display: block; }
</style>
