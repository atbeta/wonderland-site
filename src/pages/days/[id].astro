---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('days');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const body = entry.body || '';
const titleMatch = body.match(/^# Wonderland\s*[—–-]\s*([^\n(]+?)(?:\s*\(run\s+(\d+)\))?\s*$/m);
// 组合标题存在数字（组合 1：）与字母（组合 A：）两种形态。
const collisionToc = [...body.matchAll(/^##\s+组合\s+[0-9A-Z]+[：:]\s*(.+?)\s*$/gm)].map((m) => m[1].trim());
const sparkCards = [...body.matchAll(/^###\s+💥\s+#(\d+)\s+[—–-]\s+(.+)$/gm)].map((m) => ({
  n: m[1],
  title: m[2].trim(),
}));
const cardCount = sparkCards.length;

// 目录：有组合标题按组合分节；无组合标题的期数退回卡片锚点列表。
const toc = collisionToc.length > 0
  ? collisionToc.map((c, i) => ({ num: String(i + 1).padStart(2, '0'), text: c, href: `#collision-${i + 1}` }))
  : sparkCards.map((c) => ({ num: `#${c.n}`, text: c.title, href: `#spark-${c.n}` }));

const dateLabel = titleMatch?.[1]?.trim() || entry.id;
const runHint = titleMatch?.[2] || null;

const allEntries = await getCollection('days');
const sorted = allEntries
  .map((e) => ({
    id: e.id,
    dateLabel: (e.body || '').match(/^# Wonderland\s*[—–-]\s*([^\n(]+?)(?:\s*\(run\s+\d+\))?\s*$/m)?.[1]?.trim() || e.id,
    runHint: (e.body || '').match(/\(run\s+(\d+)\)/)?.[1] || null,
  }))
  .sort((a, b) => {
    const da = a.id.match(/(\d{4}-\d{2}-\d{2})/)?.[1] || '';
    const db = b.id.match(/(\d{4}-\d{2}-\d{2})/)?.[1] || '';
    if (da !== db) return db.localeCompare(da);
    return Number(b.runHint || 1) - Number(a.runHint || 1);
  });
const idx = sorted.findIndex((e) => e.id === entry.id);
// sorted is newest-first: idx-1 is the newer issue, idx+1 the older one.
const newer = sorted[idx - 1];
const older = sorted[idx + 1];
---

<BaseLayout title={`${dateLabel} — Wonderland`}>
  <div class="read-progress" id="read-progress" aria-hidden="true"></div>

  <article class="day container">
    <nav class="back-link">
      <a href="/">← 日志</a>
    </nav>

    <header class="day-head">
      <p class="day-meta">
        <span class="day-meta-mono">{dateLabel}</span>
        {runHint && <span class="day-run">run {runHint}</span>}
        <span class="day-count">{collisionToc.length > 0 ? `${collisionToc.length} 组碰撞 · ` : ''}{cardCount} 张火花</span>
      </p>
      <h1 class="day-title">Wonderland <span class="day-title-sep">—</span> <span class="grad-text">{dateLabel}</span></h1>
      {toc.length > 0 && (
        <nav class="day-toc" aria-label="本期目录">
          <p class="toc-kicker">本期目录</p>
          <ol class="toc-list">
            {toc.map((item) => (
              <li>
                <a href={item.href}>
                  <span class="toc-num">{item.num}</span>
                  <span class="toc-text">{item.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </header>

    <div class="day-body">
      <Content components={{}} />
    </div>

    <nav class="day-nav">
      {older ? (
        <a href={`/days/${older.id}/`} class="day-nav-link prev">
          <span class="nav-kicker">← 更早一期</span>
          <span class="nav-title">{older.dateLabel}</span>
        </a>
      ) : <span class="day-nav-spacer" />}
      {newer ? (
        <a href={`/days/${newer.id}/`} class="day-nav-link next">
          <span class="nav-kicker">更新一期 →</span>
          <span class="nav-title">{newer.dateLabel}</span>
        </a>
      ) : <span class="day-nav-spacer" />}
    </nav>
  </article>
</BaseLayout>

<script>
  // Reading progress bar.
  (function() {
    var bar = document.getElementById('read-progress');
    if (!bar) return;
    var onScroll = function() {
      var total = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.transform = 'scaleX(' + (total > 0 ? Math.min(window.scrollY / total, 1) : 0) + ')';
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();

  // Anchor ids for the 组合 headings so the TOC can jump to them.
  (function() {
    var heads = document.querySelectorAll('.day-body h2');
    var n = 0;
    heads.forEach(function(h) {
      if (/^组合\s*[0-9A-Z]+/.test(h.textContent || '')) {
        n++;
        h.id = 'collision-' + n;
      }
    });
  })();

  // Restructure spark card headings: split "💥 #N — title" into a mono
  // index chip + serif title, and give the card a #spark-N anchor.
  // Purely presentational.
  (function() {
    document.querySelectorAll('.day-body .spark-card > h3').forEach(function(h) {
      var text = h.textContent || '';
      var m = text.match(/^💥\s*#(\d+)\s*[—–-]\s*([\s\S]*)$/);
      if (!m) return;
      var card = h.closest('section.spark-card');
      if (card) card.id = 'spark-' + m[1];
      h.textContent = '';
      var num = document.createElement('span');
      num.className = 'spark-index';
      num.textContent = '№ ' + m[1].padStart(2, '0');
      var title = document.createElement('span');
      title.className = 'spark-title';
      title.textContent = m[2].trim();
      h.appendChild(num);
      h.appendChild(title);
    });
  })();
</script>

<style is:global>
  .day-body {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--text);
  }

  .day-body > h1, .day-body > h2, .day-body > h3 {
    font-family: var(--font-serif);
    letter-spacing: 0.01em;
    color: var(--text);
  }

  .day-body > h1 { display: none; }

  .day-body > h2 {
    font-size: 1.5rem;
    font-weight: 900;
    margin: 4rem 0 1.25rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 5.5rem;
  }

  .day-body > h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 1.75rem 0 0.5rem;
    color: var(--accent);
  }

  .day-body p { margin: 0.9rem 0; }

  .day-body ul, .day-body ol { margin: 0.9rem 0 0.9rem 1.5rem; }
  .day-body li { margin: 0.35rem 0; }

  .day-body blockquote {
    border-left: 2px solid transparent;
    border-image: var(--grad) 1;
    margin: 1.25rem 0;
    padding: 0.75rem 0 0.75rem 1.25rem;
    color: var(--text-muted);
    font-style: italic;
    font-family: var(--font-serif);
    background: var(--accent-subtle);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .day-body img {
    display: block;
    width: 100%;
    max-width: 720px;
    margin: 1.75rem auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .day-body hr {
    border: none;
    margin: 3rem 0;
    text-align: center;
  }
  .day-body hr::after {
    content: '✺ ✺ ✺';
    color: var(--text-dim);
    letter-spacing: 1rem;
    font-size: 0.75rem;
  }

  /* ---- spark card ---- */
  .day-body section.spark-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    margin: 2.5rem 0;
    overflow: hidden;
    box-shadow: var(--shadow);
    scroll-margin-top: 5.5rem;
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
  }
  .day-body section.spark-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--grad);
    opacity: 0.55;
    transition: opacity 0.3s;
  }
  .day-body section.spark-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md), var(--glow);
  }
  .day-body section.spark-card:hover::before { opacity: 1; }

  .day-body section.spark-card > h3 {
    margin: 0;
    padding: 1.25rem 1.5rem 1.1rem 1.75rem;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: 0.01em;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .day-body .spark-index {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .day-body dl.spark-meta {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.9rem 1.5rem;
    margin: 0;
    padding: 1.25rem 1.5rem 1.4rem 1.75rem;
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .day-body .spark-meta dt {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    padding-top: 0.3rem;
    align-self: start;
  }

  .day-body .spark-meta dd {
    margin: 0;
    color: var(--text);
  }

  .day-body .spark-meta dt.dt-score {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .day-body .spark-meta dd.dd-score {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .day-body .spark-meta .score-num {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text);
    min-width: 2rem;
    font-variant-numeric: tabular-nums;
  }

  .day-body .spark-meta .score-bar {
    display: inline-block;
    width: 120px;
    height: 3px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
    flex: 0 0 120px;
  }

  .day-body .spark-meta .score-bar-fill {
    display: block;
    height: 100%;
    background: var(--grad);
    border-radius: 999px;
    transition: width 0.6s cubic-bezier(0.2, 0, 0.2, 1);
  }

  /* Gallery (## 配图) */
  .day-body .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin: 1.75rem 0;
  }

  .day-body .gallery figure {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-alt);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .day-body .gallery figure:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .day-body .gallery img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    margin: 0;
    border: none;
    border-radius: 0;
  }

  .day-body .gallery figcaption {
    padding: 0.65rem 0.9rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    font-family: var(--font-serif);
  }

  /* Image embedded inside the spark card (e.g. "画面" row carrying ![]()) */
  .day-body .spark-meta .dd-image {
    display: block;
    width: 100%;
    max-width: 720px;
    margin: 0.75rem 0 0.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-alt);
    transition: transform 0.5s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.3s;
  }
  .day-body .spark-meta .dd-image:hover {
    transform: scale(1.015);
    box-shadow: var(--shadow-md);
  }

  /* Image sitting as its own paragraph immediately after a spark card */
  .day-body section.spark-card + p:has(> img) {
    margin: -0.75rem 0 2.5rem;
    text-align: center;
  }
  .day-body section.spark-card + p > img {
    display: block;
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-alt);
    transition: transform 0.5s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.3s;
  }
  .day-body section.spark-card + p > img:hover {
    transform: scale(1.015);
    box-shadow: var(--shadow-md);
  }

  /* Quote inside a spark card (连接点分析 blockquote) gets softer styling */
  .day-body section.spark-card blockquote {
    margin: 0.75rem 1.5rem 0.75rem 1.75rem;
    background: var(--bg-alt);
  }

  /* First paragraph of a spark card (often 连接点) reads as the lede */
  .day-body section.spark-card > p:first-of-type {
    margin: 1rem 1.5rem 0 1.75rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .day-body dl.spark-meta { grid-template-columns: 1fr; gap: 0.25rem 0; }
    .day-body .spark-meta dt { padding-top: 0.6rem; }
    .day-body .spark-meta dt:first-child { padding-top: 0; }
    .day-body section.spark-card > h3 { padding: 1.1rem 1.25rem 1rem 1.5rem; }
    .day-body dl.spark-meta { padding: 1.1rem 1.25rem 1.25rem 1.5rem; }
  }
</style>

<style>
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--grad);
    transform: scaleX(0);
    transform-origin: 0 50%;
    z-index: 200;
  }

  .day {
    padding: 2.5rem 1.5rem 4rem;
    max-width: 880px;
  }

  .back-link { margin-bottom: 2.5rem; }
  .back-link a {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .back-link a:hover { color: var(--accent); }

  .day-head {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .day-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .day-meta-mono {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .day-run {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-dim);
    background: var(--bg-alt);
    border: 1px solid var(--border);
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .day-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.06em;
  }

  .day-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 900;
    color: var(--text);
    letter-spacing: 0.01em;
    line-height: 1.15;
  }

  .day-title-sep { color: var(--text-dim); font-weight: 400; }

  .day-toc {
    margin-top: 1.75rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .toc-kicker {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }

  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .toc-list a {
    display: flex;
    gap: 0.85rem;
    align-items: baseline;
    color: var(--text-muted);
    font-size: 0.9375rem;
    transition: color 0.18s;
  }
  .toc-list a:hover { color: var(--accent); }

  .toc-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    flex: 0 0 auto;
  }

  .day-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .day-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.5rem 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  }
  .day-nav-link.next { text-align: right; }
  .day-nav-link:hover {
    border-color: var(--border-strong);
    color: var(--text);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md), var(--glow);
  }

  .nav-kicker {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .nav-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .day-nav-spacer { display: block; }

  @media (max-width: 640px) {
    .day-nav { grid-template-columns: 1fr; }
    .day-nav-link.next { text-align: left; }
  }
</style>
