---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('days');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const body = entry.body || '';
const titleMatch = body.match(/^# Wonderland\s*[—–-]\s*([^\n(]+?)(?:\s*\(run\s+(\d+)\))?\s*$/m);
const collisionToc = [...body.matchAll(/^##\s+组合\s+\d+[：:]\s*(.+?)\s*$/gm)].map((m) => m[1].trim());

const dateLabel = titleMatch?.[1]?.trim() || entry.id;
const runHint = titleMatch?.[2] || null;

const allEntries = await getCollection('days');
const sorted = allEntries
  .map((e) => ({
    id: e.id,
    dateLabel: (e.body || '').match(/^# Wonderland\s*[—–-]\s*([^\n(]+?)(?:\s*\(run\s+\d+\))?\s*$/m)?.[1]?.trim() || e.id,
    runHint: (e.body || '').match(/\(run\s+(\d+)\)/)?.[1] || null,
  }))
  .sort((a, b) => {
    const da = a.id.match(/(\d{4}-\d{2}-\d{2})/)?.[1] || '';
    const db = b.id.match(/(\d{4}-\d{2}-\d{2})/)?.[1] || '';
    if (da !== db) return db.localeCompare(da);
    return Number(b.runHint || 1) - Number(a.runHint || 1);
  });
const idx = sorted.findIndex((e) => e.id === entry.id);
const newer = sorted[idx + 1];
const older = sorted[idx - 1];
---

<BaseLayout title={`${dateLabel}${runHint ? ` (run ${runHint})` : ''} — Wonderland`}>
  <article class="day container">
    <nav class="back-link">
      <a href="/">← The Log</a>
    </nav>

    <header class="day-head">
      <p class="day-meta">Wonderland · Auto-published night</p>
      <h1 class="day-title">
        {dateLabel}
        {runHint && <span class="day-run">run {runHint}</span>}
      </h1>
      {collisionToc.length > 0 && (
        <ul class="day-toc">
          {collisionToc.map((c) => (
            <li><span class="toc-bullet">↳</span> {c}</li>
          ))}
        </ul>
      )}
    </header>

    <div class="day-body">
      <Content components={{}} />
    </div>

    <nav class="day-nav">
      {older ? (
        <a href={`/days/${older.id}/`} class="day-nav-link prev">
          <span class="nav-arrow">←</span>
          <span class="nav-meta">
            <span class="nav-kicker">Earlier night</span>
            <span class="nav-title">{older.dateLabel}{older.runHint ? ` · run ${older.runHint}` : ''}</span>
          </span>
        </a>
      ) : <span class="day-nav-spacer" />}
      {newer ? (
        <a href={`/days/${newer.id}/`} class="day-nav-link next">
          <span class="nav-meta">
            <span class="nav-kicker">Newer night</span>
            <span class="nav-title">{newer.dateLabel}{newer.runHint ? ` · run ${newer.runHint}` : ''}</span>
          </span>
          <span class="nav-arrow">→</span>
        </a>
      ) : <span class="day-nav-spacer" />}
    </nav>
  </article>
</BaseLayout>

<style is:global>
  .day-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text);
  }

  .day-body > h1, .day-body > h2, .day-body > h3 {
    font-family: var(--font-serif);
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .day-body > h1 { display: none; }

  .day-body > h2 {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 3rem 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }

  .day-body > h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
    color: var(--accent);
  }

  .day-body p { margin: 0.8rem 0; }

  .day-body ul, .day-body ol { margin: 0.8rem 0 0.8rem 1.5rem; }
  .day-body li { margin: 0.3rem 0; }

  .day-body blockquote {
    border-left: 3px solid var(--accent);
    margin: 1rem 0;
    padding: 0.4rem 0 0.4rem 1rem;
    color: var(--text-muted);
    font-style: italic;
    font-family: var(--font-serif);
    background: var(--accent-subtle);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .day-body img {
    display: block;
    width: 100%;
    max-width: 720px;
    margin: 1.5rem auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .day-body hr {
    border: none;
    border-top: 1px dashed var(--border);
    margin: 2.5rem 0;
  }
</style>

<style>
  .day {
    padding: 2rem 1.5rem 4rem;
  }

  .back-link {
    margin-bottom: 2rem;
  }
  .back-link a {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .back-link a:hover { color: var(--accent); }

  .day-head {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--border);
  }

  .day-meta {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .day-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1.1;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .day-run {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-dim);
    background: var(--bg-alt);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .day-toc {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 1rem 1.25rem;
    background: var(--bg-alt);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .day-toc li {
    font-size: 0.9rem;
    color: var(--text-muted);
    display: flex;
    gap: 0.6rem;
  }
  .toc-bullet { color: var(--accent); }

  .day-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .day-nav-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    transition: border-color 0.15s, color 0.15s, transform 0.15s;
    min-height: 64px;
  }
  .day-nav-link.prev { text-align: left; }
  .day-nav-link.next { text-align: right; justify-self: end; }
  .day-nav-link:hover {
    border-color: var(--accent);
    color: var(--text);
    transform: translateY(-1px);
  }

  .nav-arrow {
    font-size: 1.25rem;
    color: var(--accent);
    line-height: 1;
  }

  .nav-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .day-nav-link.next .nav-meta { align-items: flex-end; }

  .nav-kicker {
    font-size: 0.7rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .nav-title {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .day-nav-spacer { display: block; }
</style>
