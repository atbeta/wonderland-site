---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Wonderland —— 把两个陌生的领域撞在一起，看会冒出什么火花。',
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
const homeClass = isHome ? 'active' : '';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0A12" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&family=Newsreader:ital,wght@0,600;1,400;1,600&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@700;900&display=swap" rel="stylesheet" />
    <script is:inline>
      (function() {
        var t = localStorage.getItem('wonderland-theme');
        if (t) document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <canvas id="aurora-canvas" aria-hidden="true"></canvas>

    <header class="site-header" id="site-header">
      <div class="header-inner">
        <a href="/" class="logo">
          <span class="logo-glyph">✺</span>
          <span class="logo-text">Wonderland</span>
          <span class="logo-tag">跨域灵感日志</span>
        </a>
        <nav class="nav-links">
          <a href="/" class={`nav-link ${homeClass}`}>日志</a>
          <a href="/about/" class={`nav-link ${currentPath.startsWith('/about') ? 'active' : ''}`}>关于</a>
          <a href="https://github.com/atbeta/wonderland-site" class="nav-link nav-icon-link" target="_blank" rel="noopener" title="GitHub" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
          <button id="theme-toggle" class="theme-btn nav-icon-btn" aria-label="切换主题">
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/>
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <span class="logo">
            <span class="logo-glyph">✺</span>
            <span class="logo-text">Wonderland</span>
          </span>
          <p class="footer-tagline">跨领域灵感聚合实验：遴选两个看似无关的领域，引入约束命题，检索文献锚点，记录所产生的火花。</p>
        </div>
        <div class="footer-meta">
          <a href="/">日志</a>
          <a href="/about/">关于</a>
          <a href="https://github.com/atbeta/wonderland-site" target="_blank" rel="noopener">GitHub</a>
        </div>
        <p class="footer-copy">
          {new Date().getUTCFullYear()} · 静态站 · <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      (function() {
        var btn = document.getElementById('theme-toggle');
        var html = document.documentElement;

        function effectiveTheme() {
          var stored = localStorage.getItem('wonderland-theme');
          if (stored === 'dark' || stored === 'light') return stored;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        btn.addEventListener('click', function() {
          var next = effectiveTheme() === 'dark' ? 'light' : 'dark';
          html.setAttribute('data-theme-anim', '');
          html.setAttribute('data-theme', next);
          localStorage.setItem('wonderland-theme', next);
          setTimeout(function() { html.removeAttribute('data-theme-anim'); }, 600);
        });
      })();
    </script>

    <script is:inline>
      // Sticky header: condense once the page scrolls.
      (function() {
        var header = document.getElementById('site-header');
        if (!header) return;
        var onScroll = function() {
          header.classList.toggle('scrolled', window.scrollY > 12);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      })();
    </script>

    <script is:inline>
      // Scroll reveal: elements with [data-reveal] fade/rise in, staggered via --rd.
      (function() {
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
          els.forEach(function(el) { el.classList.add('in'); });
          return;
        }
        var io = new IntersectionObserver(function(entries) {
          entries.forEach(function(en) {
            if (en.isIntersecting) {
              en.target.classList.add('in');
              io.unobserve(en.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        els.forEach(function(el) { io.observe(el); });
      })();
    </script>

    <script is:inline>
      // Aurora backdrop: slow drifting light bands + faint starfield on a 2D canvas.
      // Paused when the tab is hidden; static single frame under reduced motion.
      (function() {
        var canvas = document.getElementById('aurora-canvas');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;

        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        var w = 0, h = 0, raf = 0, frame = 0;

        var BANDS = [
          { rgb: '167,139,250', base: 0.16, thick: 0.34, amp: 0.05, speed: 0.000045, phase: 0.0, alpha: 0.16 },
          { rgb: '103,232,249', base: 0.30, thick: 0.26, amp: 0.07, speed: 0.000032, phase: 2.1, alpha: 0.12 },
          { rgb: '249,168,212', base: 0.08, thick: 0.22, amp: 0.04, speed: 0.000058, phase: 4.4, alpha: 0.08 },
          { rgb: '124, 92, 246', base: 0.42, thick: 0.30, amp: 0.06, speed: 0.000026, phase: 1.3, alpha: 0.10 }
        ];

        var stars = [];

        function isDark() {
          var t = document.documentElement.getAttribute('data-theme');
          if (t === 'dark') return true;
          if (t === 'light') return false;
          return window.matchMedia('(prefers-color-scheme: dark)').matches;
        }

        function resize() {
          w = window.innerWidth;
          h = window.innerHeight;
          canvas.width = Math.round(w * dpr);
          canvas.height = Math.round(h * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          stars = [];
          var count = Math.round((w * h) / 14000);
          for (var i = 0; i < count; i++) {
            stars.push({
              x: Math.random() * w,
              y: Math.random() * h * 0.75,
              r: Math.random() * 1.1 + 0.3,
              p: Math.random() * Math.PI * 2,
              s: 0.0004 + Math.random() * 0.0009
            });
          }
          if (reduced) draw(12000);
        }

        function bandCenter(b, x, t) {
          var nx = x / w;
          return (b.base
            + Math.sin(nx * 2.4 + t * b.speed * 1000 + b.phase) * b.amp
            + Math.sin(nx * 5.1 - t * b.speed * 640 + b.phase * 1.7) * b.amp * 0.45
          ) * h;
        }

        function draw(t) {
          var dark = isDark();
          ctx.clearRect(0, 0, w, h);

          if (dark) {
            ctx.fillStyle = 'rgba(237,237,244,1)';
            for (var i = 0; i < stars.length; i++) {
              var s = stars[i];
              var tw = 0.25 + 0.55 * (0.5 + 0.5 * Math.sin(t * s.s * 1000 + s.p));
              ctx.globalAlpha = tw * 0.5;
              ctx.beginPath();
              ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
              ctx.fill();
            }
            ctx.globalAlpha = 1;
          }

          var mood = dark ? 1 : 0.42;
          for (var j = 0; j < BANDS.length; j++) {
            var b = BANDS[j];
            var top = [], x;
            for (x = -40; x <= w + 40; x += 36) top.push([x, bandCenter(b, x, t)]);
            var thick = b.thick * h;
            var grad = ctx.createLinearGradient(0, top[0][1] - thick * 0.5, 0, top[0][1] + thick * 0.5);
            grad.addColorStop(0, 'rgba(' + b.rgb + ',0)');
            grad.addColorStop(0.5, 'rgba(' + b.rgb + ',' + (b.alpha * mood).toFixed(3) + ')');
            grad.addColorStop(1, 'rgba(' + b.rgb + ',0)');
            ctx.fillStyle = grad;
            ctx.beginPath();
            ctx.moveTo(top[0][0], top[0][1]);
            for (var k = 1; k < top.length; k++) ctx.lineTo(top[k][0], top[k][1]);
            for (var m = top.length - 1; m >= 0; m--) ctx.lineTo(top[m][0], top[m][1] + thick);
            ctx.closePath();
            ctx.fill();
          }
        }

        function loop(t) {
          frame++;
          if (frame % 2 === 0) draw(t); // ~30fps is plenty for a slow drift
          raf = requestAnimationFrame(loop);
        }

        function start() { if (!raf && !reduced) raf = requestAnimationFrame(loop); }
        function stop() { if (raf) { cancelAnimationFrame(raf); raf = 0; } }

        resize();
        window.addEventListener('resize', resize);
        document.addEventListener('visibilitychange', function() {
          if (document.hidden) stop(); else start();
        });
        start();
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* 亮色：晨曦纸白 */
    --bg: #f7f4ec;
    --bg-alt: #efeadd;
    --bg-card: #fffdf7;
    --text: #25203a;
    --text-muted: #5d5678;
    --text-dim: #9a92ac;
    --border: #e4ddcc;
    --border-strong: #d4cbb4;
    --a-violet: #7c3aed;
    --a-cyan: #0e7490;
    --a-rose: #be185d;
    --accent: #6d28d9;
    --accent-hover: #5b21b6;
    --accent-subtle: rgba(124, 58, 237, 0.09);
    --grad: linear-gradient(115deg, #7c3aed 0%, #0e7490 100%);
    --grad-soft: linear-gradient(115deg, rgba(124,58,237,0.16), rgba(14,116,144,0.14));
    --code-bg: #efeadd;
    --code-text: #25203a;
    --shadow-sm: 0 1px 3px rgba(50, 36, 20, 0.06);
    --shadow: 0 1px 3px rgba(50, 36, 20, 0.06), 0 6px 16px rgba(50, 36, 20, 0.05);
    --shadow-md: 0 2px 8px rgba(50, 36, 20, 0.07), 0 12px 32px rgba(50, 36, 20, 0.06);
    --shadow-lg: 0 6px 16px rgba(50, 36, 20, 0.09), 0 24px 56px rgba(50, 36, 20, 0.08);
    --glow: 0 0 0 rgba(0,0,0,0);
    --radius-sm: 8px;
    --radius: 14px;
    --radius-lg: 22px;
    --font-sans: 'Inter', 'Noto Sans SC', system-ui, -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    --font-mono: 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    --font-serif: 'Newsreader', 'Noto Serif SC', Georgia, 'Songti SC', 'SimSun', serif;
  }

  :root[data-theme="dark"] {
    /* 暗色：午夜梦境 */
    --bg: #0b0a12;
    --bg-alt: #13111d;
    --bg-card: #161426;
    --text: #ece9f4;
    --text-muted: #a49dbb;
    --text-dim: #665f7d;
    --border: #262138;
    --border-strong: #372f52;
    --a-violet: #a78bfa;
    --a-cyan: #67e8f9;
    --a-rose: #f9a8d4;
    --accent: #a78bfa;
    --accent-hover: #c4b5fd;
    --accent-subtle: rgba(167, 139, 250, 0.13);
    --grad: linear-gradient(115deg, #a78bfa 0%, #67e8f9 100%);
    --grad-soft: linear-gradient(115deg, rgba(167,139,250,0.15), rgba(103,232,249,0.12));
    --code-bg: #13111d;
    --code-text: #ece9f4;
    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.35);
    --shadow: 0 1px 3px rgba(0, 0, 0, 0.4), 0 6px 16px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 2px 8px rgba(0, 0, 0, 0.45), 0 14px 36px rgba(0, 0, 0, 0.32);
    --shadow-lg: 0 6px 16px rgba(0, 0, 0, 0.5), 0 28px 64px rgba(0, 0, 0, 0.4);
    --glow: 0 0 32px rgba(167, 139, 250, 0.14);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0b0a12;
      --bg-alt: #13111d;
      --bg-card: #161426;
      --text: #ece9f4;
      --text-muted: #a49dbb;
      --text-dim: #665f7d;
      --border: #262138;
      --border-strong: #372f52;
      --a-violet: #a78bfa;
      --a-cyan: #67e8f9;
      --a-rose: #f9a8d4;
      --accent: #a78bfa;
      --accent-hover: #c4b5fd;
      --accent-subtle: rgba(167, 139, 250, 0.13);
      --grad: linear-gradient(115deg, #a78bfa 0%, #67e8f9 100%);
      --grad-soft: linear-gradient(115deg, rgba(167,139,250,0.15), rgba(103,232,249,0.12));
      --code-bg: #13111d;
      --code-text: #ece9f4;
      --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.35);
      --shadow: 0 1px 3px rgba(0, 0, 0, 0.4), 0 6px 16px rgba(0, 0, 0, 0.3);
      --shadow-md: 0 2px 8px rgba(0, 0, 0, 0.45), 0 14px 36px rgba(0, 0, 0, 0.32);
      --shadow-lg: 0 6px 16px rgba(0, 0, 0, 0.5), 0 28px 64px rgba(0, 0, 0, 0.4);
      --glow: 0 0 32px rgba(167, 139, 250, 0.14);
    }
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

  html[data-theme-anim],
  html[data-theme-anim] *,
  html[data-theme-anim] *::before,
  html[data-theme-anim] *::after {
    transition: background-color 0.45s ease, color 0.45s ease, border-color 0.45s ease, box-shadow 0.45s ease !important;
  }

  body {
    font-family: var(--font-sans);
    background: var(--bg);
    color: var(--text);
    line-height: 1.75;
    font-size: 16px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  main { flex: 1; position: relative; z-index: 1; }

  ::selection { background: rgba(167, 139, 250, 0.32); color: inherit; }
  :root:not([data-theme="dark"]) ::selection { background: rgba(124, 58, 237, 0.18); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) ::selection { background: rgba(167, 139, 250, 0.32); }
  }

  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 999px;
    border: 2px solid var(--bg);
  }
  ::-webkit-scrollbar-thumb:hover { background: var(--text-dim); }

  a { color: var(--accent); text-decoration: none; transition: color 0.18s; }
  a:hover { color: var(--accent-hover); }

  img { max-width: 100%; height: auto; }

  code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    font-weight: 450;
    background: var(--code-bg);
    color: var(--code-text);
    padding: 0.15em 0.4em;
    border-radius: 5px;
  }

  pre {
    font-family: var(--font-mono);
    background: var(--code-bg);
    color: var(--code-text);
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow-x: auto;
    line-height: 1.6;
    font-size: 0.8125rem;
  }

  pre code { background: none; padding: 0; font-size: inherit; }

  .container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ---- aurora backdrop ---- */
  #aurora-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* ---- scroll reveal ---- */
  [data-reveal] {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--rd, 0ms);
  }
  [data-reveal].in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
  }

  /* ---- shared bits ---- */
  .grad-text {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .chip {
    font-size: 0.75rem;
    padding: 0.28rem 0.7rem;
    background: var(--accent-subtle);
    color: var(--accent);
    border: 1px solid transparent;
    border-radius: 999px;
    font-weight: 500;
    line-height: 1.5;
  }

  /* ---- header ---- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    transition: border-color 0.3s, background 0.3s, box-shadow 0.3s;
  }

  .site-header.scrolled {
    border-bottom-color: var(--border);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    transition: height 0.3s;
  }

  .site-header.scrolled .header-inner { height: 54px; }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .logo:hover { color: var(--text); }

  .logo-glyph {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    font-size: 1.4rem;
    line-height: 1;
    font-weight: 400;
  }

  .logo-text { font-family: var(--font-serif); font-style: italic; font-weight: 600; }

  .logo-tag {
    color: var(--text-dim);
    font-weight: 400;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  @media (max-width: 640px) { .logo-tag { display: none; } }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .nav-link {
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.18s, background 0.18s;
  }
  .nav-link:hover { color: var(--text); background: var(--accent-subtle); }
  .nav-link.active { color: var(--accent); background: var(--accent-subtle); }

  .nav-icon-link, .nav-icon-btn, .theme-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.18s, background 0.18s;
  }
  .nav-icon-link:hover, .nav-icon-btn:hover, .theme-btn:hover {
    color: var(--text);
    background: var(--accent-subtle);
  }

  .icon-sun { display: block; }
  .icon-moon { display: none; }

  :root[data-theme="dark"] .icon-sun { display: none; }
  :root[data-theme="dark"] .icon-moon { display: block; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .icon-sun { display: none; }
    :root:not([data-theme="light"]) .icon-moon { display: block; }
  }

  /* ---- footer ---- */
  .site-footer {
    position: relative;
